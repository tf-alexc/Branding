# Contrast webinar platform API credential.
# Copy this file to .env and paste the real key. .env is gitignored, never commit it.
CONTRAST_API_KEY=your_contrast_api_key_here

# Optional overrides. Leave commented unless the defaults stop working.
# CONTRAST_API_BASE_URL=https://connect.getcontrast.io
# CONTRAST_TIMEOUT=30

# Optional per-resource path overrides, if Contrast moves an endpoint.
# CONTRAST_PATH_EVENTS=/events
# CONTRAST_PATH_RECURRING_EVENTS=/recurring-events
# CONTRAST_PATH_REGISTRATIONS=/registrations
# CONTRAST_PATH_VIEWS=/views
# CONTRAST_PATH_POLLS=/polls
# CONTRAST_PATH_CHAT_MESSAGES=/chat-messages
